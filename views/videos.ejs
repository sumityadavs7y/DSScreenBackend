<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="/css/video-js.css">
    <title>Media Library - Digital Signage</title>
    <style>
        /* Video Thumbnail */
        .video-thumbnail {
            width: 80px;
            height: 60px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            cursor: pointer;
            transition: all 0.3s;
            box-shadow: 0 2px 8px rgba(102, 126, 234, 0.2);
            overflow: hidden;
            position: relative;
        }
        .video-thumbnail:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
        }
        .video-thumbnail i {
            font-size: 1.5rem;
        }
        .video-thumbnail img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .video-thumbnail .play-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.3s;
        }
        .video-thumbnail:hover .play-overlay {
            opacity: 1;
        }
        .video-thumbnail .play-overlay i {
            font-size: 2rem;
            color: white;
            filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.5));
        }
        
        /* Video Name */
        .video-name-clickable {
            cursor: pointer;
            color: #333;
            font-weight: 500;
            transition: color 0.2s;
        }
        .video-name-clickable:hover {
            color: #667eea;
        }
        
        /* Table Styling */
        .table > :not(caption) > * > * {
            padding: 1rem 0.75rem;
        }
        .table thead th {
            font-weight: 600;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #6c757d;
            border-bottom: 2px solid #dee2e6;
        }
        .table tbody tr {
            transition: background-color 0.2s;
        }
        .table tbody tr:hover {
            background-color: rgba(102, 126, 234, 0.05);
        }
        
        /* Checkbox Styling */
        .form-check-input {
            cursor: pointer;
            width: 1.25rem;
            height: 1.25rem;
            margin: 0;
        }
        .form-check-input:checked {
            background-color: #667eea;
            border-color: #667eea;
        }
        
        /* Button Group */
        .btn-group-sm > .btn {
            padding: 0.375rem 0.75rem;
            font-size: 0.875rem;
        }
        
        /* Video Player Modal */
        #videoPlayerModal .modal-dialog {
            max-width: 900px;
        }
        #videoPlayerModal .modal-body {
            padding: 0;
            background: #000;
        }
        .video-js {
            width: 100%;
            height: 500px;
        }
        
        /* Upload Progress Bar */
        #uploadProgressContainer {
            margin-top: 1rem;
            padding: 1rem;
            background: #f8f9fa;
            border-radius: 8px;
        }
        #uploadProgressContainer .progress {
            background-color: #e9ecef;
            border-radius: 10px;
            overflow: hidden;
        }
        #uploadProgressContainer .progress-bar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            font-weight: 600;
            font-size: 0.875rem;
        }
        #uploadProgressContainer small {
            font-size: 0.875rem;
        }
        
        /* Disabled state styling */
        .modal-content button:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }
        .modal-content input:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }
    </style>
</head>
<body>
    <%- include('partials/navbar', { user, company, userCompany, session }) %>

    <!-- Toast Notification Container -->
    <div class="toast-container" id="toastContainer"></div>

    <div class="content-wrapper">
        <div class="container">
            <!-- Navigation Tabs -->
            <%- include('partials/dashboard-tabs', { currentPage: 'videos', user, company, userCompany, session }) %>

            <!-- Media Library Content -->
            <div class="card table-card">
                <div class="card-header bg-white border-0 py-3">
                    <div class="row align-items-center">
                        <div class="col">
                            <h4 class="mb-0"><i class="bi bi-collection-play"></i> Media Library</h4>
                        </div>
                        <div class="col-auto">
                            <% if (videos && videos.length > 0) { %>
                                <button id="deleteSelectedBtn" class="btn btn-danger me-2" onclick="showBulkDeleteModal()" style="display: none;">
                                    <i class="bi bi-trash"></i> <span class="d-none d-md-inline">Delete Selected</span>
                                </button>
                            <% } %>
                            <button class="btn btn-gradient" data-bs-toggle="modal" data-bs-target="#uploadModal">
                                <i class="bi bi-cloud-upload"></i> Upload Media
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <% if (!videos || videos.length === 0) { %>
                        <!-- Empty State -->
                        <div class="empty-state">
                            <i class="bi bi-film"></i>
                            <h3 class="mt-3">No Media Yet</h3>
                            <p class="text-muted">Upload your first video or image using the button above.</p>
                        </div>
                    <% } else { %>
                        <!-- Video Table -->
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th width="50" class="text-center align-middle">
                                            <input type="checkbox" class="form-check-input m-0" id="selectAll" onchange="toggleSelectAll(this)">
                                        </th>
                                        <th>Video</th>
                                        <th class="d-none d-md-table-cell" width="120">Size</th>
                                        <th class="d-none d-lg-table-cell" width="100">Duration</th>
                                        <th class="d-none d-lg-table-cell" width="140">Uploaded</th>
                                        <th width="130" class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% videos.forEach(video => { %>
                                        <tr>
                                            <td class="text-center">
                                                <div class="form-check d-flex justify-content-center">
                                                    <input type="checkbox" class="form-check-input video-checkbox" 
                                                           value="<%= video.id %>" 
                                                           data-name="<%= video.fileName %>">
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="video-thumbnail me-3" onclick='playVideo("<%= video.id %>", "<%= video.fileName.replace(/"/g, "&quot;") %>")'>
                                                        <% if (video.thumbnailPath) { %>
                                                            <img src="/api/media/<%= video.id %>/thumbnail" alt="<%= video.fileName %>" loading="lazy">
                                                            <div class="play-overlay">
                                                                <i class="bi bi-play-fill"></i>
                                                            </div>
                                                        <% } else { %>
                                                            <i class="bi bi-play-fill"></i>
                                                        <% } %>
                                                    </div>
                                                    <div class="flex-grow-1">
                                                        <div class="video-name-clickable mb-1" onclick='playVideo("<%= video.id %>", "<%= video.fileName.replace(/"/g, "&quot;") %>")'>
                                                            <%= video.fileName %>
                                                            <% if (video.mimeType && video.mimeType.startsWith('image/')) { %>
                                                                <span class="badge bg-info ms-2">
                                                                    <i class="bi bi-image"></i> Image
                                                                </span>
                                                            <% } else { %>
                                                                <span class="badge bg-primary ms-2">
                                                                    <i class="bi bi-film"></i> Video
                                                                </span>
                                                            <% } %>
                                                        </div>
                                                        <small class="text-muted d-md-none">
                                                            <%= formatFileSize(video.fileSize) %>
                                                        </small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="d-none d-md-table-cell text-muted">
                                                <%= formatFileSize(video.fileSize) %>
                                            </td>
                                            <td class="d-none d-lg-table-cell text-muted">
                                                <%= video.duration ? formatDuration(video.duration) : 'N/A' %>
                                            </td>
                                            <td class="d-none d-lg-table-cell text-muted">
                                                <%= new Date(video.uploadedAt).toLocaleDateString() %>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm d-flex justify-content-center" role="group">
                                                    <button class="btn btn-outline-primary" 
                                                            onclick='openEditModal("<%= video.id %>", "<%= video.fileName.replace(/"/g, '&quot;') %>")'
                                                            title="Edit">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <button class="btn btn-outline-danger" 
                                                            onclick='deleteVideo("<%= video.id %>")'
                                                            title="Delete">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Upload Modal -->
    <div class="modal fade" id="uploadModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-cloud-upload"></i> Upload Media</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" id="uploadModalClose"></button>
                </div>
                <form id="uploadForm" action="javascript:void(0);" enctype="multipart/form-data">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="video" class="form-label">Select Media Files</label>
                            <input type="file" class="form-control" id="video" name="video" accept="video/*,image/*" multiple required>
                            <small class="text-muted">Max size: 500MB per file. Videos: MP4, WebM, OGG, MOV, AVI | Images: JPG, PNG, GIF, WebP (10s display)</small>
                        </div>
                        <div id="fileList" class="mb-3" style="display: none;">
                            <small class="text-muted">Selected files:</small>
                            <div id="fileListItems" class="mt-2"></div>
                        </div>
                        <!-- Progress Bar -->
                        <div id="uploadProgressContainer" style="display: none;">
                            <!-- Overall Progress -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <strong class="text-primary">Overall Progress</strong>
                                    <small class="text-muted">
                                        <span id="uploadCompletedFiles">0</span> of <span id="uploadTotalFiles">1</span> files completed
                                    </small>
                                </div>
                                <div class="progress" style="height: 25px; background-color: #e9ecef;">
                                    <div id="uploadOverallProgressBar" 
                                         class="progress-bar bg-success" 
                                         role="progressbar" 
                                         style="width: 0%"
                                         aria-valuenow="0" 
                                         aria-valuemin="0" 
                                         aria-valuemax="100">
                                        <span id="uploadOverallPercent" class="fw-bold">0%</span>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Current File Progress -->
                            <div class="mb-2">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <small class="text-muted" id="uploadStatus">Uploading...</small>
                                    <small class="text-muted"><span id="uploadCurrentFilePercent">0</span>%</small>
                                </div>
                                <div class="progress" style="height: 20px;">
                                    <div id="uploadProgressBar" 
                                         class="progress-bar progress-bar-striped progress-bar-animated" 
                                         role="progressbar" 
                                         style="width: 0%"
                                         aria-valuenow="0" 
                                         aria-valuemin="0" 
                                         aria-valuemax="100">
                                    </div>
                                </div>
                            </div>
                            
                            <!-- File List -->
                            <div id="uploadFileStatusList" class="mt-3" style="max-height: 200px; overflow-y: auto;">
                                <!-- File status items will be added here dynamically -->
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="uploadCancelBtn">Cancel</button>
                        <button type="submit" class="btn btn-gradient" id="uploadSubmitBtn">
                            <i class="bi bi-upload"></i> Upload
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Edit Modal -->
    <div class="modal fade" id="editModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-pencil"></i> Edit Video Name</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="editForm" method="POST">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="editFileName" class="form-label">Video Name</label>
                            <input type="text" class="form-control" id="editFileName" name="fileName" required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-gradient">
                            <i class="bi bi-check-lg"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Bulk Delete Modal -->
    <div class="modal fade" id="bulkDeleteModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="bi bi-trash"></i> Delete Media</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form action="/dashboard/media/bulk-delete" method="POST">
                    <div class="modal-body">
                        <p>Are you sure you want to delete the following videos?</p>
                        <div id="selectedVideosList" class="list-group mb-3"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Video Player Modal -->
    <div class="modal fade" id="videoPlayerModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="videoPlayerTitle">
                        <i class="bi bi-play-circle"></i> Video Player
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <video id="videoPlayer" class="video-js vjs-default-skin" controls preload="auto">
                        Your browser does not support the video tag.
                    </video>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/scripts') %>
    <script src="/js/video.min.js"></script>
    <script>
        const editModal = new bootstrap.Modal(document.getElementById('editModal'));
        const bulkDeleteModal = new bootstrap.Modal(document.getElementById('bulkDeleteModal'));
        const videoPlayerModal = new bootstrap.Modal(document.getElementById('videoPlayerModal'));
        const uploadModal = new bootstrap.Modal(document.getElementById('uploadModal'));
        let player = null;

        // Show selected files
        const videoInput = document.getElementById('video');
        const fileList = document.getElementById('fileList');
        const fileListItems = document.getElementById('fileListItems');
        
        videoInput.addEventListener('change', () => {
            const files = Array.from(videoInput.files);
            if (files.length > 0) {
                fileList.style.display = 'block';
                fileListItems.innerHTML = files.map((file, index) => 
                    `<small class="d-block text-muted mb-1">
                        <i class="bi bi-file-earmark-fill"></i> ${file.name} (${(file.size / 1024 / 1024).toFixed(2)} MB)
                    </small>`
                ).join('');
            } else {
                fileList.style.display = 'none';
            }
        });
        
        // Helper function to create file status item
        function createFileStatusItem(fileName, index) {
            return `
                <div id="fileStatus-${index}" class="d-flex align-items-center mb-2 p-2 rounded" style="background-color: #f8f9fa;">
                    <i id="fileIcon-${index}" class="bi bi-hourglass-split text-secondary me-2"></i>
                    <span class="flex-grow-1 small" style="word-break: break-all;">${fileName}</span>
                    <span id="fileStatusText-${index}" class="badge bg-secondary ms-2">Waiting</span>
                </div>
            `;
        }
        
        // Helper function to update file status
        function updateFileStatus(index, status, iconClass, badgeClass) {
            const icon = document.getElementById(`fileIcon-${index}`);
            const statusText = document.getElementById(`fileStatusText-${index}`);
            const statusItem = document.getElementById(`fileStatus-${index}`);
            
            if (icon) {
                icon.className = `bi ${iconClass} me-2`;
            }
            if (statusText) {
                statusText.textContent = status;
                statusText.className = `badge ${badgeClass} ms-2`;
            }
            if (statusItem && status === 'Completed') {
                statusItem.style.backgroundColor = '#d4edda';
            } else if (statusItem && status === 'Failed') {
                statusItem.style.backgroundColor = '#f8d7da';
            } else if (statusItem && status === 'Uploading') {
                statusItem.style.backgroundColor = '#d1ecf1';
            }
        }

        // Handle direct S3 upload with multiple files
        document.getElementById('uploadForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const fileInput = document.getElementById('video');
            const files = Array.from(fileInput.files);
            
            if (files.length === 0) {
                alert('Please select at least one media file (video or image)');
                return;
            }

            const submitBtn = document.getElementById('uploadSubmitBtn');
            const cancelBtn = document.getElementById('uploadCancelBtn');
            const closeBtn = document.getElementById('uploadModalClose');
            const progressContainer = document.getElementById('uploadProgressContainer');
            const progressBar = document.getElementById('uploadProgressBar');
            const uploadStatus = document.getElementById('uploadStatus');
            const uploadTotalFiles = document.getElementById('uploadTotalFiles');
            const uploadCompletedFiles = document.getElementById('uploadCompletedFiles');
            const uploadOverallProgressBar = document.getElementById('uploadOverallProgressBar');
            const uploadOverallPercent = document.getElementById('uploadOverallPercent');
            const uploadCurrentFilePercent = document.getElementById('uploadCurrentFilePercent');
            const uploadFileStatusList = document.getElementById('uploadFileStatusList');

            let successCount = 0;
            let errorCount = 0;
            const errors = [];

            try {
                // Disable buttons
                submitBtn.disabled = true;
                cancelBtn.disabled = true;
                closeBtn.disabled = true;
                fileInput.disabled = true;
                progressContainer.style.display = 'block';
                
                uploadTotalFiles.textContent = files.length;
                uploadCompletedFiles.textContent = '0';
                
                // Create file status list
                uploadFileStatusList.innerHTML = files.map((file, index) => 
                    createFileStatusItem(file.name, index)
                ).join('');

                // Update progress
                function updateProgress(percent, status) {
                    progressBar.style.width = percent + '%';
                    progressBar.setAttribute('aria-valuenow', percent);
                    uploadCurrentFilePercent.textContent = Math.round(percent);
                    if (status) {
                        uploadStatus.textContent = status;
                    }
                }
                
                // Update overall progress
                function updateOverallProgress() {
                    const completedCount = successCount + errorCount;
                    const overallPercent = (completedCount / files.length) * 100;
                    uploadOverallProgressBar.style.width = overallPercent + '%';
                    uploadOverallProgressBar.setAttribute('aria-valuenow', overallPercent);
                    uploadOverallPercent.textContent = Math.round(overallPercent) + '%';
                    uploadCompletedFiles.textContent = completedCount;
                }

                // Upload each file
                for (let i = 0; i < files.length; i++) {
                    const file = files[i];
                    const fileNum = i + 1;
                    
                    try {
                        console.log(`\n📤 Uploading file ${fileNum}/${files.length}: ${file.name}`);
                        updateFileStatus(i, 'Uploading', 'bi-cloud-upload-fill text-primary', 'bg-primary');
                        
                        // Step 1: Request upload URL
                        console.log('Step 1: Requesting upload URL...');
                        updateProgress(10, `[${fileNum}/${files.length}] Preparing ${file.name}...`);
                        
                        const urlResponse = await fetch('/api/media/request-upload-url', {
                            method: 'POST',
                            credentials: 'include',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                fileName: file.name,
                                fileSize: file.size,
                                mimeType: file.type,
                            }),
                        });

                        if (!urlResponse.ok) {
                            const error = await urlResponse.json();
                            throw new Error(error.message || 'Failed to get upload URL');
                        }

                        const { data } = await urlResponse.json();
                        console.log('✅ Got upload URL. Video ID:', data.videoId);

                        // Step 2: Upload to S3 with progress
                        console.log('Step 2: Uploading to S3...');
                        updateProgress(20, `[${fileNum}/${files.length}] Uploading ${file.name}...`);

                        await new Promise((resolve, reject) => {
                            const xhr = new XMLHttpRequest();
                            
                            xhr.upload.addEventListener('progress', (e) => {
                                if (e.lengthComputable) {
                                    const percent = 20 + (e.loaded / e.total) * 60; // 20% to 80%
                                    const uploadPercent = Math.round((e.loaded / e.total) * 100);
                                    updateProgress(percent, `[${fileNum}/${files.length}] Uploading ${file.name}... ${uploadPercent}%`);
                                }
                            });

                            xhr.addEventListener('load', () => {
                                console.log('S3 Response Status:', xhr.status);
                                if (xhr.status === 200) {
                                    console.log('✅ Uploaded to S3');
                                    resolve();
                                } else {
                                    console.error('❌ S3 upload failed:', {
                                        status: xhr.status,
                                        statusText: xhr.statusText,
                                        response: xhr.responseText,
                                        headers: xhr.getAllResponseHeaders()
                                    });
                                    reject(new Error(`S3 upload failed: ${xhr.status} ${xhr.statusText}`));
                                }
                            });

                            xhr.addEventListener('error', (e) => {
                                console.error('❌ Network error:', e);
                                reject(new Error('Network error during upload'));
                            });

                            xhr.open('PUT', data.uploadUrl);
                            xhr.send(file);
                        });

                        // Step 3: Complete upload
                        updateProgress(85, `[${fileNum}/${files.length}] Processing ${file.name}...`);

                        const completeResponse = await fetch(`/api/media/${data.videoId}/complete-upload`, {
                            method: 'POST',
                            credentials: 'include',
                        });

                        console.log('Complete response status:', completeResponse.status);

                        if (!completeResponse.ok) {
                            let errorMessage = 'Failed to process video';
                            try {
                                const error = await completeResponse.json();
                                console.error('Complete-upload error response:', error);
                                errorMessage = error.message || errorMessage;
                            } catch (e) {
                                console.error('Could not parse error response');
                            }
                            throw new Error(errorMessage);
                        }

                        const result = await completeResponse.json();
                        console.log('✅ Upload complete! Result:', result);

                        if (!result.success) {
                            throw new Error(result.message || 'Upload completed but with errors');
                        }

                        updateProgress(100, `[${fileNum}/${files.length}] ${file.name} complete!`);
                        updateFileStatus(i, 'Completed', 'bi-check-circle-fill text-success', 'bg-success');
                        successCount++;
                        updateOverallProgress();
                        
                    } catch (error) {
                        console.error(`❌ Error uploading ${file.name}:`, error);
                        updateFileStatus(i, 'Failed', 'bi-x-circle-fill text-danger', 'bg-danger');
                        errorCount++;
                        errors.push({ fileName: file.name, error: error.message });
                        updateOverallProgress();
                    }
                }

                // All uploads complete - show results
                if (successCount > 0 && errorCount === 0) {
                    alert(`Successfully uploaded ${successCount} file(s)!`);
                    uploadModal.hide();
                    window.location.reload();
                } else if (successCount > 0 && errorCount > 0) {
                    const errorList = errors.map(e => `${e.fileName}: ${e.error}`).join('\n');
                    alert(`Uploaded ${successCount} file(s) successfully.\n${errorCount} file(s) failed:\n\n${errorList}`);
                    uploadModal.hide();
                    window.location.reload();
                } else {
                    const errorList = errors.map(e => `${e.fileName}: ${e.error}`).join('\n');
                    throw new Error(`All uploads failed:\n\n${errorList}`);
                }

            } catch (error) {
                console.error('Upload error:', error);
                alert('Upload failed: ' + error.message);
                
                // Reset form
                progressContainer.style.display = 'none';
                progressBar.style.width = '0%';
                uploadCurrentFilePercent.textContent = '0';
                uploadStatus.textContent = 'Uploading...';
                uploadOverallProgressBar.style.width = '0%';
                uploadOverallPercent.textContent = '0%';
                uploadCompletedFiles.textContent = '0';
                uploadFileStatusList.innerHTML = '';
                submitBtn.disabled = false;
                cancelBtn.disabled = false;
                closeBtn.disabled = false;
                fileInput.disabled = false;
                fileInput.value = '';
                fileList.style.display = 'none';
            }
        });

        function openEditModal(videoId, videoName) {
            document.getElementById('editForm').action = `/dashboard/media/${videoId}/edit`;
            document.getElementById('editFileName').value = videoName;
            editModal.show();
        }

        function playVideo(videoId, videoName) {
            document.getElementById('videoPlayerTitle').innerHTML = `<i class="bi bi-play-circle"></i> ${videoName}`;
            
            if (player) {
                player.dispose();
                player = null;
            }

            let videoElement = document.getElementById('videoPlayer');
            
            if (!videoElement) {
                const modalBody = document.querySelector('#videoPlayerModal .modal-body');
                modalBody.innerHTML = '<video id="videoPlayer" class="video-js vjs-default-skin" controls preload="auto">Your browser does not support the video tag.</video>';
                videoElement = document.getElementById('videoPlayer');
            }
            
            player = videojs(videoElement, {
                controls: true,
                autoplay: false,
                preload: 'auto',
                fluid: false,
                responsive: true,
                aspectRatio: '16:9',
                sources: [{
                    src: `/api/media/${videoId}/download`,
                    type: 'video/mp4'
                }]
            });

            videoPlayerModal.show();

            const modalElement = document.getElementById('videoPlayerModal');
            modalElement.addEventListener('shown.bs.modal', function () {
                if (player) {
                    player.play().catch(err => {
                        console.log('Autoplay prevented:', err);
                    });
                }
            }, { once: true });
        }

        document.getElementById('videoPlayerModal').addEventListener('hidden.bs.modal', function () {
            if (player) {
                player.pause();
            }
        });

        function toggleSelectAll(checkbox) {
            const checkboxes = document.querySelectorAll('.video-checkbox');
            checkboxes.forEach(cb => cb.checked = checkbox.checked);
            updateDeleteButtonVisibility();
        }

        function updateDeleteButtonVisibility() {
            const deleteBtn = document.getElementById('deleteSelectedBtn');
            if (deleteBtn) {
                const checkedBoxes = document.querySelectorAll('.video-checkbox:checked');
                deleteBtn.style.display = checkedBoxes.length > 0 ? 'inline-block' : 'none';
            }
        }

        // Add event listeners to all checkboxes
        document.addEventListener('DOMContentLoaded', function() {
            const checkboxes = document.querySelectorAll('.video-checkbox');
            checkboxes.forEach(cb => {
                cb.addEventListener('change', updateDeleteButtonVisibility);
            });
        });

        function deleteVideo(videoId) {
            if (confirm('Are you sure you want to delete this media?')) {
                // Create a form and submit it
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/dashboard/media/${videoId}/delete`;
                document.body.appendChild(form);
                form.submit();
            }
        }

        function showBulkDeleteModal() {
            const checkboxes = document.querySelectorAll('.video-checkbox:checked');
            
            if (checkboxes.length === 0) {
                alert('Please select at least one video to delete.');
                return;
            }
            
            const listHtml = Array.from(checkboxes).map(cb => 
                `<input type="hidden" name="videoIds[]" value="${cb.value}">
                 <div class="list-group-item">${cb.dataset.name}</div>`
            ).join('');
            
            document.getElementById('selectedVideosList').innerHTML = listHtml;
            bulkDeleteModal.show();
        }

        // Legacy upload code removed - now using direct S3 upload (see event listener above)
    </script>
</body>
</html>

<%
function formatFileSize(bytes) {
    if (!bytes) return 'N/A';
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(1024));
    return (bytes / Math.pow(1024, i)).toFixed(2) + ' ' + sizes[i];
}

function formatDuration(seconds) {
    if (!seconds) return 'N/A';
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return `${mins}:${secs.toString().padStart(2, '0')}`;
}
%>

