<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Digital Signage - by Logical Valley Infotech</title>
    <link rel="icon" type="image/png" href="/logo.png">
    <link rel="apple-touch-icon" href="/logo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css">
    <script src="https://cdn.socket.io/4.5.4/socket.io.min.js"></script>
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }
        .main-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            max-width: 500px;
            width: 100%;
            overflow: hidden;
        }
        @media (min-width: 768px) {
            .main-card {
                max-width: 900px;
            }
        }
        .card-header-custom {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 2rem;
            text-align: center;
        }
        .card-body-custom {
            padding: 2rem;
        }
        .code-input-group {
            display: flex;
            gap: 0.5rem;
            justify-content: center;
            margin: 1.5rem 0;
        }
        .code-input {
            width: 3rem;
            height: 3.5rem;
            text-align: center;
            font-size: 1.5rem;
            font-weight: bold;
            border: 2px solid #dee2e6;
            border-radius: 10px;
            transition: all 0.3s;
        }
        .code-input:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }
        .btn-gradient {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            color: white;
            padding: 0.75rem;
        }
        .btn-gradient:hover {
            background: linear-gradient(135deg, #5568d3 0%, #6a3f8f 100%);
            color: white;
        }
        .divider {
            text-align: center;
            position: relative;
            margin: 1.5rem 0;
        }
        .divider::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 1px;
            background: #dee2e6;
        }
        .divider span {
            background: white;
            padding: 0 1rem;
            position: relative;
            color: #6c757d;
            font-size: 0.875rem;
        }
        .status-indicator {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 10px;
        }
        .status-indicator.connecting {
            background-color: #fef3c7;
            color: #92400e;
        }
        .status-indicator.connected {
            background-color: #d1fae5;
            color: #065f46;
        }
        .status-indicator.disconnected {
            background-color: #fee2e2;
            color: #991b1b;
        }
        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            animation: pulse 2s infinite;
        }
        .status-indicator.connecting .status-dot {
            background-color: #f59e0b;
        }
        .status-indicator.connected .status-dot {
            background-color: #10b981;
        }
        .status-indicator.disconnected .status-dot {
            background-color: #ef4444;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        .qr-container {
            background: #f9fafb;
            border-radius: 12px;
            padding: 20px;
            margin: 15px 0;
            display: none;
        }
        .qr-container.show {
            display: block;
        }
        .qr-code {
            max-width: 250px;
            width: 100%;
            height: auto;
            border-radius: 8px;
            background: white;
            padding: 10px;
            margin: 0 auto;
            display: block;
        }
        .registration-url {
            margin-top: 15px;
            padding: 10px;
            background: white;
            border-radius: 8px;
            border: 2px dashed #d1d5db;
        }
        .registration-url p {
            color: #6b7280;
            font-size: 11px;
            margin-bottom: 5px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .registration-url a {
            color: #667eea;
            text-decoration: none;
            font-weight: 600;
            word-break: break-all;
            font-size: 12px;
        }
        .spinner-small {
            border: 3px solid #f3f4f6;
            border-top: 3px solid #667eea;
            border-radius: 50%;
            width: 30px;
            height: 30px;
            animation: spin 1s linear infinite;
            margin: 10px auto;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        .qr-section {
            margin-bottom: 20px;
        }
        .registration-row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 20px;
        }
        .registration-col {
            flex: 1;
            min-width: 280px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .vertical-divider {
            display: none;
            align-items: center;
            justify-content: center;
            padding: 0 20px;
            color: #6c757d;
            font-size: 1.2rem;
            font-weight: 600;
        }
        @media (min-width: 768px) {
            .registration-row {
                flex-wrap: nowrap;
            }
            .registration-col {
                flex: 1;
                min-width: 0;
            }
            .vertical-divider {
                display: flex;
            }
            .mobile-divider {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="main-card">
        <div class="card-header-custom">
            <img src="/logo.png" alt="Digital Signage Logo" style="height: 60px; margin-bottom: 10px;">
            <h1 class="mb-0">Digital Signage</h1>
            <p class="mb-0 mt-2">by Logical Valley Infotech</p>
        </div>
        <div class="card-body-custom">
            <!-- Alert Messages -->
            <div id="alert"></div>

            <!-- Registration Methods Row -->
            <div class="registration-row">
                <!-- QR Code Registration Column -->
                <div class="registration-col">
                    <div class="qr-section">
                        <div class="text-center">
                            <h5><i class="bi bi-qr-code"></i> Quick Registration</h5>
                            <p class="text-muted small mb-2">Scan QR code with your mobile device</p>
                            
                            <!-- Connection Status -->
                            <div id="statusIndicator" class="status-indicator connecting">
                                <span class="status-dot"></span>
                                <span id="statusText">Connecting...</span>
                            </div>
                        </div>

                        <!-- Loading State -->
                        <div id="qrLoading" style="text-align: center; padding: 20px;">
                            <div class="spinner-small"></div>
                            <p class="text-muted small mb-0">Generating QR Code...</p>
                        </div>

                        <!-- QR Code Display -->
                        <div id="qrContainer" class="qr-container">
                            <img id="qrCode" class="qr-code" alt="Registration QR Code">
                            <div class="registration-url">
                                <p class="mb-1">Or open this link:</p>
                                <a id="registrationUrl" href="#" target="_blank"></a>
                            </div>
                        </div>

                        <!-- Success Message -->
                        <div id="qrSuccess" class="alert alert-success" style="display: none; margin-top: 10px;">
                            <h6 class="mb-1">✅ Registration Successful!</h6>
                            <p id="qrSuccessMessage" class="small mb-0"></p>
                        </div>

                        <!-- Error Message -->
                        <div id="qrError" class="alert alert-danger" style="display: none; margin-top: 10px;">
                            <p class="small mb-0" id="qrErrorMessage"></p>
                        </div>

                        <div class="device-id text-center" style="margin-top: 10px;">
                            <small class="text-muted">Device: <span id="deviceId">...</span></small>
                        </div>
                    </div>
                </div>

                <!-- Vertical Divider (Desktop Only) -->
                <div class="vertical-divider">
                    <span>OR</span>
                </div>

                <!-- Manual Entry Column -->
                <div class="registration-col">
                    <div class="text-center mb-1">
                        <h5><i class="bi bi-keyboard"></i> Manual Entry</h5>
                        <p class="text-muted small mb-2">Enter your 5-character playlist code</p>
                    </div>

                    <form id="deviceForm">
                        <div class="code-input-group">
                            <input type="text" class="code-input form-control" maxlength="1" id="code1" autocomplete="off" required>
                            <input type="text" class="code-input form-control" maxlength="1" id="code2" autocomplete="off" required>
                            <input type="text" class="code-input form-control" maxlength="1" id="code3" autocomplete="off" required>
                            <input type="text" class="code-input form-control" maxlength="1" id="code4" autocomplete="off" required>
                            <input type="text" class="code-input form-control" maxlength="1" id="code5" autocomplete="off" required>
                        </div>
                        
                        <button type="submit" class="btn btn-gradient btn-lg w-100 mb-3">
                            <i class="bi bi-check-circle"></i> Register Device
                        </button>
                    </form>
                </div>
            </div>

            <!-- Mobile Divider (Mobile Only) -->
            <div class="divider mobile-divider">
                <span>or</span>
            </div>

            <!-- Divider -->
            <div class="divider">
                <span>or manage your content</span>
            </div>

            <!-- Auth Buttons -->
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <a href="/login" class="btn btn-outline-primary w-100">
                        <i class="bi bi-box-arrow-in-right"></i> Login
                    </a>
                </div>
                <div class="col-6">
                    <a href="/register" class="btn btn-outline-primary w-100">
                        <i class="bi bi-person-plus"></i> Register
                    </a>
                </div>
            </div>

            <p class="text-center small text-muted mb-0">
                Need help? <a href="mailto:support@logicalvalley.in" class="text-decoration-none">Contact Support</a> | 
                <a href="/privacy-policy" class="text-decoration-none">Privacy Policy</a>
            </p>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/device-registration.js"></script>
    <script>
        // QR Code Registration Logic
        const API_BASE_URL = window.location.origin;
        const SOCKET_URL = window.location.origin;

        let socket = null;
        let deviceId = null;
        let sessionToken = null;

        // DOM Elements
        const statusIndicator = document.getElementById('statusIndicator');
        const statusText = document.getElementById('statusText');
        const qrLoading = document.getElementById('qrLoading');
        const qrContainer = document.getElementById('qrContainer');
        const qrCode = document.getElementById('qrCode');
        const registrationUrl = document.getElementById('registrationUrl');
        const qrSuccess = document.getElementById('qrSuccess');
        const qrSuccessMessage = document.getElementById('qrSuccessMessage');
        const qrError = document.getElementById('qrError');
        const qrErrorMessage = document.getElementById('qrErrorMessage');
        const deviceIdEl = document.getElementById('deviceId');

        // Generate device ID
        function generateDeviceId() {
            const nav = navigator;
            const screen = window.screen;
            const fingerprint = [
                nav.userAgent,
                nav.language,
                screen.colorDepth,
                screen.width + 'x' + screen.height,
                new Date().getTimezoneOffset(),
                !!window.sessionStorage,
                !!window.localStorage,
            ].join('|');

            let hash = 0;
            for (let i = 0; i < fingerprint.length; i++) {
                const char = fingerprint.charCodeAt(i);
                hash = ((hash << 5) - hash) + char;
                hash = hash & hash;
            }

            return 'device_' + Math.abs(hash).toString(36) + '_' + Date.now().toString(36);
        }

        // Update connection status
        function updateStatus(status) {
            statusIndicator.className = `status-indicator ${status}`;
            
            switch(status) {
                case 'connecting':
                    statusText.textContent = 'Connecting...';
                    break;
                case 'connected':
                    statusText.textContent = 'Connected';
                    break;
                case 'disconnected':
                    statusText.textContent = 'Disconnected';
                    break;
            }
        }

        // Show error
        function showQrError(message) {
            qrErrorMessage.textContent = message;
            qrError.style.display = 'block';
            qrLoading.style.display = 'none';
        }

        // Initialize Socket.IO
        function initSocket() {
            updateStatus('connecting');
            
            socket = io(SOCKET_URL, {
                transports: ['websocket', 'polling'],
                reconnection: true,
                reconnectionDelay: 1000,
                reconnectionAttempts: 5
            });

            socket.on('connect', () => {
                console.log('✅ Socket connected:', socket.id);
                updateStatus('connected');
                socket.emit('device:join', deviceId);
            });

            socket.on('device:connected', (data) => {
                console.log('✅ Device joined room:', data);
            });

            socket.on('disconnect', () => {
                console.log('❌ Socket disconnected');
                updateStatus('disconnected');
            });

            socket.on('connect_error', (err) => {
                console.error('❌ Socket connection error:', err);
                updateStatus('disconnected');
            });

            // Listen for registration completion
            socket.on('registration:complete', (data) => {
                console.log('✅ Registration complete:', data);
                console.log('📋 Playlist items received:', data.playlist.items?.length || 0);
                qrContainer.classList.remove('show');
                qrSuccess.style.display = 'block';
                qrSuccessMessage.textContent = `Successfully registered to playlist: ${data.playlist.name} (${data.playlist.code}). Redirecting...`;
                
                // Store device info with full data - matching manual registration structure
                const registrationData = {
                    playlistCode: data.playlist.code,
                    uid: deviceId,
                    device: data.device,
                    playlist: data.playlist, // This now includes items array
                    deviceInfo: {
                        resolution: `${window.screen.width}x${window.screen.height}`,
                        browser: navigator.userAgent,
                        platform: navigator.platform,
                        timestamp: new Date().toISOString()
                    },
                    registeredAt: new Date().toISOString()
                };
                
                localStorage.setItem('devicePlaylistRegistration', JSON.stringify(registrationData));
                console.log('💾 Registration data saved to localStorage');
                
                // Redirect to player page after 2 seconds
                setTimeout(() => {
                    window.location.href = '/device-player';
                }, 2000);
            });
        }

        // Initialize registration session
        async function initQrRegistration() {
            try {
                qrLoading.style.display = 'block';
                
                const response = await fetch(`${API_BASE_URL}/api/device/init-registration`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ deviceId }),
                });

                const result = await response.json();

                if (!result.success) {
                    throw new Error(result.message || 'Failed to initialize registration');
                }

                sessionToken = result.data.sessionToken;
                
                // Display QR code
                qrCode.src = result.data.qrCodeDataUrl;
                
                // Construct registration URL using current origin (fixes localhost issue in production)
                const actualRegistrationUrl = `${window.location.origin}/device-register?session=${sessionToken}`;
                registrationUrl.href = actualRegistrationUrl;
                registrationUrl.textContent = actualRegistrationUrl;

                // Show QR container
                qrLoading.style.display = 'none';
                qrContainer.classList.add('show');

                console.log('✅ QR Registration session created:', sessionToken);

            } catch (err) {
                console.error('❌ Error initializing QR registration:', err);
                showQrError('Failed to generate QR code. Please try manual entry below.');
            }
        }

        // Initialize QR registration on page load
        (function initQr() {
            deviceId = generateDeviceId();
            deviceIdEl.textContent = deviceId.substring(0, 20) + '...';

            console.log('📱 Device ID:', deviceId);

            initSocket();
            initQrRegistration();
        })();
    </script>
</body>
</html>

