<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Device Player - Digital Signage</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            background: #0a0a0a;
            overflow-x: hidden;
            overflow-y: auto;
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
        }
        
        /* Main Container */
        #mainContainer {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }
        
        /* Video Player Container */
        #videoContainer {
            background: #000;
            border-radius: 12px;
            overflow: hidden;
            margin-bottom: 20px;
            height: 70vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        #videoPlayer, #imagePlayer {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }
        
        #videoPlayer {
            display: block;
        }
        
        #imagePlayer {
            display: none; /* Hidden by default, controlled by JavaScript */
        }
        
        /* When in fullscreen mode - using class-based approach (more reliable) */
        body.is-fullscreen #mainContainer {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            right: 0 !important;
            bottom: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            background: #000 !important;
            z-index: 9999 !important;
            margin: 0 !important;
            padding: 0 !important;
        }
        
        body.is-fullscreen #videoContainer {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            right: 0 !important;
            bottom: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            background: #000 !important;
            margin: 0 !important;
            padding: 0 !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
        }
        
        /* Fullscreen media sizing - applies to both video and image */
        body.is-fullscreen #videoPlayer,
        body.is-fullscreen #imagePlayer {
            width: 100vw !important;
            height: 100vh !important;
            max-width: 100vw !important;
            max-height: 100vh !important;
            object-fit: contain !important;
            position: absolute !important;
            top: 0 !important;
            left: 0 !important;
        }
        
        /* Hide UI elements in fullscreen */
        body.is-fullscreen .info-overlay,
        body.is-fullscreen .click-to-play-overlay {
            display: none !important;
        }
        
        /* Cache Progress Indicator */
        #cacheIndicator {
            background: #10b981;
            color: white;
            padding: 12px 20px;
            border-radius: 8px;
            font-size: 13px;
            margin-bottom: 15px;
            opacity: 0;
            transition: opacity 0.3s;
            display: none;
        }
        
        #cacheIndicator.show {
            opacity: 1;
            display: block;
        }
        
        #cacheIndicator .progress-bar {
            height: 6px;
            background: rgba(255, 255, 255, 0.3);
            border-radius: 3px;
            margin-top: 8px;
            overflow: hidden;
        }
        
        #cacheIndicator .progress-fill {
            height: 100%;
            background: white;
            width: 0%;
            transition: width 0.3s;
        }
        
        /* Controls Section */
        #controlsSection {
            background: #1a1a1a;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 20px;
        }
        
        /* Control Buttons */
        #fullscreenToggleBtn,
        #deregisterBtn {
            color: white;
            border: none;
            padding: 14px 28px;
            border-radius: 8px;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.3s, transform 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            justify-content: center;
            margin-bottom: 12px;
        }
        
        #fullscreenToggleBtn {
            background: #10b981;
        }
        
        #fullscreenToggleBtn:hover {
            background: #059669;
            transform: translateY(-2px);
        }
        
        #fullscreenToggleBtn:active {
            transform: translateY(0);
        }
        
        #fullscreenToggleBtn i {
            font-size: 18px;
        }
        
        #deregisterBtn {
            background: #dc2626;
        }
        
        #deregisterBtn:hover {
            background: #b91c1c;
            transform: translateY(-2px);
        }
        
        #deregisterBtn:active {
            transform: translateY(0);
        }
        
        /* Debug Info Section */
        #debugSection {
            background: #1a1a1a;
            border-radius: 12px;
            padding: 20px;
            color: #9ca3af;
            font-size: 14px;
            font-family: monospace;
        }
        
        #debugSection h3 {
            color: #fff;
            margin: 0 0 15px 0;
            font-size: 16px;
        }
        
        #debugSection p {
            margin: 8px 0;
            color: #d1d5db;
        }
        
        #debugSection strong {
            color: #10b981;
            display: inline-block;
            min-width: 150px;
        }
        
        
        /* Fullscreen Start Overlay (shown on page load) */
        #fullscreenStartOverlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10000;
            color: white;
            cursor: pointer;
            opacity: 1;
            visibility: visible;
            transition: opacity 0.5s, visibility 0.5s;
        }
        
        #fullscreenStartOverlay.hide {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }
        
        #fullscreenStartOverlay .fullscreen-prompt {
            text-align: center;
            padding: 40px;
            background: rgba(0, 0, 0, 0.3);
            border-radius: 20px;
            backdrop-filter: blur(10px);
            max-width: 600px;
        }
        
        #fullscreenStartOverlay i {
            animation: pulse 2s infinite;
        }
        
        @keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.1); opacity: 0.8; }
        }
        
        #fullscreenStartOverlay:hover .fullscreen-prompt {
            background: rgba(0, 0, 0, 0.5);
            transform: scale(1.02);
            transition: all 0.3s ease;
        }
        
        /* Error Display */
        #errorOverlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.95);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 2000;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.3s, visibility 0.3s;
        }
        
        #errorOverlay.show {
            opacity: 1;
            visibility: visible;
        }
        
        .error-container {
            background: #dc2626;
            color: white;
            padding: 30px;
            border-radius: 15px;
            text-align: center;
            max-width: 500px;
        }
        
        .error-container h2 {
            margin-bottom: 15px;
        }
        
        .error-container button {
            margin-top: 15px;
            padding: 10px 30px;
            background: white;
            color: #dc2626;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <div id="mainContainer">
        <!-- Media Player (Video & Image) -->
        <div id="videoContainer">
            <video id="videoPlayer" autoplay playsinline></video>
            <img id="imagePlayer" alt="Display Image" />
        </div>
        
        <!-- Controls Section -->
        <div id="controlsSection">
            <!-- Cache Progress Indicator -->
            <div id="cacheIndicator">
                <div id="cacheText">Caching videos... 0/0</div>
                <div class="progress-bar">
                    <div class="progress-fill" id="cacheProgressBar"></div>
                </div>
            </div>
            
            <!-- Fullscreen Toggle Button -->
            <button id="fullscreenToggleBtn" onclick="toggleFullscreen()">
                <i class="bi bi-arrows-fullscreen" id="fullscreenIcon"></i>
                <span id="fullscreenText">Enter Fullscreen</span>
            </button>
            
            <!-- Deregister Button -->
            <button id="deregisterBtn" onclick="goHome()">
                <i class="bi bi-arrow-left-circle"></i>
                Change Playlist / Deregister Device
            </button>
        </div>
        
        <!-- Debug Info Section -->
        <div id="debugSection">
            <h3>📊 Playback Information</h3>
            <p><strong>Device UID:</strong> <span id="infoDeviceUID">-</span></p>
            <p><strong>Playlist:</strong> <span id="infoPlaylistName">-</span></p>
            <p><strong>License Expires:</strong> <span id="infoLicenseExpiry">-</span></p>
            <p><strong>Current Video:</strong> <span id="infoCurrentVideo">-</span> / <span id="infoTotalVideos">-</span></p>
            <p><strong>Timeline Loop:</strong> #<span id="infoLoopCount">0</span></p>
            <p><strong>Video Time:</strong> <span id="infoVideoTime">00:00</span> / <span id="infoVideoDuration">00:00</span></p>
            <p><strong>Item Duration:</strong> <span id="infoItemDuration">-</span>s</p>
            <p><strong>Item Elapsed:</strong> <span id="infoItemElapsed">0</span>s</p>
            <p><strong>Cache Status:</strong> <span id="infoCacheStatus">-</span></p>
            <p><strong>Next Timeline Check:</strong> <span id="infoNextUpdate">-</span>s</p>
        </div>
    </div>
    
    <!-- Fullscreen Start Overlay (shown on page load) -->
    <div id="fullscreenStartOverlay" onclick="handleFullscreenStart()">
        <div class="fullscreen-prompt">
            <i class="bi bi-arrows-fullscreen" style="font-size: 80px; margin-bottom: 20px;"></i>
            <h2 style="margin: 0 0 15px 0; font-size: 32px;">Digital Signage Display</h2>
            <p style="margin: 0; font-size: 20px;">Tap anywhere to enter fullscreen and start playback</p>
        </div>
    </div>
    
    <!-- Click to Play Overlay (hidden, kept for compatibility) -->
    <div id="clickToPlayOverlay" style="display: none;"></div>
    
    <!-- Error Overlay -->
    <div id="errorOverlay">
        <div class="error-container">
            <h2>⚠️ Error</h2>
            <p id="errorMessage">An error occurred</p>
            <button onclick="goHome()">Go Home</button>
        </div>
    </div>

    <script>
        // ==================== INDEXEDDB SETUP ====================
        const DB_NAME = 'digitalSignageCache';
        const DB_VERSION = 1;
        const VIDEO_STORE = 'videos';
        let db = null;

        async function initDB() {
            return new Promise((resolve, reject) => {
                const request = indexedDB.open(DB_NAME, DB_VERSION);
                request.onerror = () => reject(request.error);
                request.onsuccess = () => {
                    db = request.result;
                    resolve(db);
                };
                request.onupgradeneeded = (event) => {
                    const db = event.target.result;
                    if (!db.objectStoreNames.contains(VIDEO_STORE)) {
                        db.createObjectStore(VIDEO_STORE, { keyPath: 'id' });
                    }
                };
            });
        }

        async function saveVideoToCache(videoId, videoBlob) {
            return new Promise((resolve, reject) => {
                const transaction = db.transaction([VIDEO_STORE], 'readwrite');
                const store = transaction.objectStore(VIDEO_STORE);
                const request = store.put({ id: videoId, blob: videoBlob, cachedAt: Date.now() });
                request.onsuccess = () => resolve();
                request.onerror = () => reject(request.error);
            });
        }

        async function getVideoFromCache(videoId) {
            return new Promise((resolve, reject) => {
                const transaction = db.transaction([VIDEO_STORE], 'readonly');
                const store = transaction.objectStore(VIDEO_STORE);
                const request = store.get(videoId);
                request.onsuccess = () => resolve(request.result);
                request.onerror = () => reject(request.error);
            });
        }

        async function clearVideoCache() {
            return new Promise((resolve, reject) => {
                const transaction = db.transaction([VIDEO_STORE], 'readwrite');
                const store = transaction.objectStore(VIDEO_STORE);
                const request = store.clear();
                request.onsuccess = () => resolve();
                request.onerror = () => reject(request.error);
            });
        }

        // ==================== GLOBAL STATE ====================
        let registrationData = null;
        let timelineItems = [];
        let currentVideoIndex = 0;
        let loopCount = 0;
        let videoPlayer = null;
        let imagePlayer = null;
        let cacheStatus = {};
        let currentMediaType = null; // 'video' or 'image'
        let imageDisplayTimeout = null; // Timeout for image display duration
        let isInitialPlay = true; // Track if this is the first play (needs user interaction)
        let hasUserInteracted = false; // Track if user has clicked anywhere
        let itemStartTime = 0;
        let itemDuration = 0;
        let checkIntervalId = null;
        let updateIntervalId = null;
        let timelineCheckIntervalId = null;
        let lastTimelineCheck = Date.now();
        let hasEnteredFullscreenOnce = false;

        // ==================== INITIALIZATION ====================
        document.addEventListener('DOMContentLoaded', init);

        async function init() {
            console.log('🚀 Initializing Device Player...');
            
            try {
                // Initialize IndexedDB
                await initDB();
                console.log('✅ IndexedDB initialized');
                
                // Get registration data
                const storedData = localStorage.getItem('devicePlaylistRegistration');
                if (!storedData) {
                    showError('No device registration found. Redirecting to home...');
                    setTimeout(() => goHome(), 3000);
                    return;
                }
                
                registrationData = JSON.parse(storedData);
                const playlist = registrationData.data?.playlist || registrationData.playlist;
                
                if (!playlist || !playlist.items || playlist.items.length === 0) {
                    showError('Playlist is empty. Please add videos to your playlist.');
                    return;
                }
                
                // Check license status immediately on load
                console.log('🔍 Checking license status...');
                try {
                    const timelineResponse = await fetch(`/api/playlists/${playlist.id}/timeline`);
                    if (timelineResponse.ok) {
                        const timelineResult = await timelineResponse.json();
                        
                        // Check license
                        if (timelineResult.license) {
                            const license = timelineResult.license;
                            console.log('📜 License status:', license.isExpired ? '❌ EXPIRED' : '✅ Active', '| Expires:', license.expiresAt);
                            
                            // Update license display
                            updateLicenseDisplay(license);
                            
                            if (license.isExpired || !license.isActive) {
                                showError('License has expired. Please contact your administrator to renew the license.');
                                return;
                            }
                        }
                        
                        // Update timeline with latest data
                        if (timelineResult.data && timelineResult.data.length > 0) {
                            timelineItems = [...timelineResult.data].sort((a, b) => a.order - b.order);
                            console.log(`📋 Timeline loaded from server: ${timelineItems.length} videos`);
                        } else {
                            // Fallback to local data
                            timelineItems = [...playlist.items].sort((a, b) => a.order - b.order);
                            console.log(`📋 Timeline loaded from cache: ${timelineItems.length} videos`);
                        }
                    } else {
                        // If API fails, use local data
                        timelineItems = [...playlist.items].sort((a, b) => a.order - b.order);
                        console.log(`📋 Timeline loaded from cache (API unavailable): ${timelineItems.length} videos`);
                    }
                } catch (err) {
                    console.warn('⚠️  Failed to fetch initial timeline, using cached data:', err.message);
                    timelineItems = [...playlist.items].sort((a, b) => a.order - b.order);
                }
                
                // Update info overlay
                const deviceUID = localStorage.getItem('deviceUID') || 'Unknown';
                document.getElementById('infoDeviceUID').textContent = deviceUID;
                document.getElementById('infoPlaylistName').textContent = playlist.name;
                document.getElementById('infoTotalVideos').textContent = timelineItems.length;
                
                // Setup media players
                videoPlayer = document.getElementById('videoPlayer');
                imagePlayer = document.getElementById('imagePlayer');
                videoPlayer.addEventListener('timeupdate', updateVideoInfo);
                
                // Track user interactions to enable unmuted autoplay
                document.addEventListener('click', () => {
                    if (!hasUserInteracted) {
                        hasUserInteracted = true;
                        console.log('✅ User interaction detected, unmuted playback enabled');
                        
                        // Unmute video if it's currently playing muted
                        if (videoPlayer && !videoPlayer.paused && videoPlayer.muted) {
                            videoPlayer.muted = false;
                            console.log('🔊 Unmuted currently playing video');
                        }
                    }
                }, { once: false });
                
                // Initialize cache status
                for (const item of timelineItems) {
                    cacheStatus[item.video.id] = { cached: false, caching: false };
                }
                
                // Start background caching
                startBackgroundCaching();
                
                // Initialize video index but DON'T start playback yet
                // Wait for user to click the fullscreen overlay
                currentVideoIndex = 0;
                loopCount = 0;
                
                // Show fullscreen start overlay (user must click to begin)
                console.log('✅ Ready to start. Waiting for user to enter fullscreen...');
                
                // Note: Playback will start when user clicks fullscreen overlay
                // See handleFullscreenStart() function
                
            } catch (error) {
                console.error('❌ Initialization error:', error);
                showError(`Initialization failed: ${error.message}`);
            }
        }

        // ==================== TIMELINE UPDATE CHECKER ====================
        async function checkForTimelineUpdates() {
            try {
                lastTimelineCheck = Date.now();
                console.log('🔍 Checking for timeline updates...');
                
                const playlist = registrationData.data?.playlist || registrationData.playlist;
                const playlistId = playlist.id;
                
                // Fetch latest timeline from server
                const response = await fetch(`/api/playlists/${playlistId}/timeline`);
                
                if (!response.ok) {
                    console.error('Failed to fetch timeline updates:', response.status);
                    return;
                }
                
                const result = await response.json();
                
                // Check license status first
                if (result.license) {
                    const license = result.license;
                    console.log('📜 License check:', license.isExpired ? '❌ EXPIRED' : '✅ Active', '| Expires:', license.expiresAt);
                    
                    // Update license display
                    updateLicenseDisplay(license);
                    
                    // If license is expired, stop playback
                    if (license.isExpired || !license.isActive) {
                        console.error('❌ License has expired! Stopping playback...');
                        
                        // Stop video playback
                        if (videoPlayer) {
                            videoPlayer.pause();
                            videoPlayer.src = '';
                        }
                        
                        // Clear all intervals
                        if (checkIntervalId) clearInterval(checkIntervalId);
                        if (updateIntervalId) clearInterval(updateIntervalId);
                        if (timelineCheckIntervalId) clearInterval(timelineCheckIntervalId);
                        
                        // Show license expired message
                        showError('License has expired. Please contact your administrator to renew the license.');
                        return;
                    }
                } else {
                    console.warn('⚠️  No license information available');
                    document.getElementById('infoLicenseExpiry').textContent = 'No license info';
                }
                
                if (!result.success || !result.data || result.data.length === 0) {
                    console.log('No timeline data received');
                    return;
                }
                
                // Sort new timeline items
                const newTimelineItems = [...result.data].sort((a, b) => a.order - b.order);
                
                // Check if timeline has changed
                const hasChanged = detectTimelineChanges(timelineItems, newTimelineItems);
                
                if (hasChanged) {
                    console.log('✅ Timeline has changed! Updating...');
                    await handleTimelineUpdate(newTimelineItems);
                } else {
                    console.log('ℹ️  Timeline unchanged');
                }
                
            } catch (error) {
                console.error('❌ Error checking timeline updates:', error);
            }
        }

        function detectTimelineChanges(oldTimeline, newTimeline) {
            // Check if length changed
            if (oldTimeline.length !== newTimeline.length) {
                console.log(`Timeline length changed: ${oldTimeline.length} → ${newTimeline.length}`);
                return true;
            }
            
            // Check each item for changes
            for (let i = 0; i < oldTimeline.length; i++) {
                const oldItem = oldTimeline[i];
                const newItem = newTimeline[i];
                
                // Check if video ID changed
                if (oldItem.video.id !== newItem.video.id) {
                    console.log(`Video at position ${i} changed: ${oldItem.video.id} → ${newItem.video.id}`);
                    return true;
                }
                
                // Check if duration changed
                if (oldItem.duration !== newItem.duration) {
                    console.log(`Duration at position ${i} changed: ${oldItem.duration}s → ${newItem.duration}s`);
                    return true;
                }
                
                // Check if order changed
                if (oldItem.order !== newItem.order) {
                    console.log(`Order at position ${i} changed: ${oldItem.order} → ${newItem.order}`);
                    return true;
                }
            }
            
            return false;
        }

        async function handleTimelineUpdate(newTimelineItems) {
            console.log('🔄 Applying timeline updates...');
            
            // Update global timeline
            timelineItems = newTimelineItems;
            
            // Update info overlay
            document.getElementById('infoTotalVideos').textContent = timelineItems.length;
            
            // Check for new videos that need caching
            const newVideosToCache = [];
            
            for (const item of timelineItems) {
                const videoId = item.video.id;
                
                // If this video is not in cache status, it's new
                if (!cacheStatus[videoId]) {
                    cacheStatus[videoId] = { cached: false, caching: false };
                    newVideosToCache.push(item);
                }
            }
            
            // Cache new videos in background
            if (newVideosToCache.length > 0) {
                console.log(`📥 Found ${newVideosToCache.length} new video(s) to cache`);
                cacheNewVideos(newVideosToCache);
            }
            
            // Update registration data
            if (registrationData.data?.playlist) {
                registrationData.data.playlist.items = timelineItems;
            } else if (registrationData.playlist) {
                registrationData.playlist.items = timelineItems;
            }
            localStorage.setItem('devicePlaylistRegistration', JSON.stringify(registrationData));
            
            console.log('✅ Timeline updated successfully');
        }

        async function cacheNewVideos(newVideos) {
            const totalVideos = timelineItems.length;
            const alreadyCached = Object.values(cacheStatus).filter(s => s.cached).length;
            
            // Show cache indicator
            updateCacheIndicator(alreadyCached, totalVideos);
            
            for (const item of newVideos) {
                try {
                    cacheStatus[item.video.id].caching = true;
                    await cacheVideo(item);
                    cacheStatus[item.video.id].cached = true;
                    
                    const newCachedCount = Object.values(cacheStatus).filter(s => s.cached).length;
                    updateCacheIndicator(newCachedCount, totalVideos);
                } catch (error) {
                    console.error(`❌ Failed to cache new video ${item.video.fileName}:`, error);
                    cacheStatus[item.video.id].caching = false;
                }
            }
            
            const finalCachedCount = Object.values(cacheStatus).filter(s => s.cached).length;
            if (finalCachedCount === totalVideos) {
                setTimeout(() => hideCacheIndicator(), 3000);
            }
        }

        // ==================== PLAYBACK CONTROL ====================
        async function playCurrentVideo() {
            if (currentVideoIndex >= timelineItems.length) {
                return false;
            }
            
            const item = timelineItems[currentVideoIndex];
            const videoId = item.video.id;
            const mediaName = item.video.fileName;
            const mimeType = item.video.mimeType;
            const isImage = mimeType && mimeType.startsWith('image/');
            
            currentMediaType = isImage ? 'image' : 'video';
            
            console.log(`▶️  Playing [${currentVideoIndex + 1}/${timelineItems.length}]: ${mediaName} (${currentMediaType})`);
            
            // Update info overlay
            document.getElementById('infoCurrentVideo').textContent = currentVideoIndex + 1;
            document.getElementById('infoLoopCount').textContent = loopCount;
            document.getElementById('infoItemDuration').textContent = item.duration;
            
            // Set item duration and start time
            itemDuration = item.duration;
            itemStartTime = Date.now();
            
            try {
                // Check if media is cached
                const cachedMedia = await getVideoFromCache(videoId); // Works for both videos and images
                let mediaURL;
                
                if (cachedMedia) {
                    console.log(`✅ Playing from cache: ${mediaName}`);
                    mediaURL = URL.createObjectURL(cachedMedia.blob);
                } else {
                    console.log(`🌐 Streaming directly from S3: ${mediaName}`);
                    const streamData = await getVideoStreamURL(videoId);
                    mediaURL = streamData.streamUrl;
                    
                    // Store expiry time for potential refresh
                    window.currentVideoExpiry = new Date(streamData.expiresAt).getTime();
                }
                
                if (isImage) {
                    // Display image
                    videoPlayer.style.display = 'none';
                    videoPlayer.pause();
                    videoPlayer.src = '';
                    
                    imagePlayer.src = mediaURL;
                    imagePlayer.style.display = 'block';
                    hideClickToPlay();
                    
                    // Set timeout to advance after duration
                    const displayDuration = (item.duration || 10) * 1000; // Default 10 seconds
                    console.log(`🖼️  Displaying image for ${displayDuration / 1000} seconds`);
                    
                    // Clear any existing timeout
                    if (imageDisplayTimeout) {
                        clearTimeout(imageDisplayTimeout);
                    }
                    
                    // Start checking item duration
                    startItemDurationCheck();
                    
                    return true; // Success
                    
                } else {
                    // Play video
                    imagePlayer.style.display = 'none';
                    imagePlayer.src = '';
                    
                    videoPlayer.style.display = 'block';
                    videoPlayer.src = mediaURL;
                    videoPlayer.loop = true; // Loop the video
                    
                    // Always start muted for reliable autoplay (kiosk mode)
                    // Will unmute after user clicks anywhere on the page
                    videoPlayer.muted = !hasUserInteracted;
                    videoPlayer.volume = 1.0; // Full volume (when unmuted)
                    videoPlayer.load();
                    
                    try {
                        await videoPlayer.play();
                        hideClickToPlay();
                        
                        // If muted, try to unmute after a short delay if user has interacted
                        if (videoPlayer.muted && hasUserInteracted) {
                            setTimeout(() => {
                                videoPlayer.muted = false;
                            }, 100);
                        }
                        
                        // Mark as no longer initial play after first successful play
                        if (isInitialPlay) {
                            isInitialPlay = false;
                        }
                        
                        // Start checking item duration
                        startItemDurationCheck();
                        return true; // Success
                    } catch (playError) {
                        console.log('⚠️ Autoplay blocked, trying with muted:', playError);
                        
                        // For kiosk mode: always try muted, never show click-to-play overlay
                        videoPlayer.muted = true;
                        try {
                            await videoPlayer.play();
                            hideClickToPlay();
                            console.log('✅ Playing with muted audio (for kiosk mode)');
                            
                            if (isInitialPlay) {
                                isInitialPlay = false;
                            }
                            
                            startItemDurationCheck();
                            return true;
                        } catch (mutedPlayError) {
                            console.error('❌ Even muted play failed:', mutedPlayError);
                            // Skip to next if completely blocked
                            advanceToNextVideo();
                            return false;
                        }
                    }
                }
                
            } catch (error) {
                console.error(`❌ Playback error for ${mediaName}:`, error);
                // Skip to next item on error
                advanceToNextVideo();
                return false;
            }
        }
        
        function showClickToPlay() {
            const overlay = document.getElementById('clickToPlayOverlay');
            if (overlay) {
                overlay.classList.add('show');
            }
        }
        
        function hideClickToPlay() {
            const overlay = document.getElementById('clickToPlayOverlay');
            if (overlay) {
                overlay.classList.remove('show');
            }
        }
        
        async function handleClickToPlay() {
            hideClickToPlay();
            hasUserInteracted = true; // Mark user interaction
            isInitialPlay = false; // No longer initial play
            
            try {
                // Unmute and play
                videoPlayer.muted = false;
                await videoPlayer.play();
                startItemDurationCheck();
                
                console.log('🔊 Playback started with user interaction (unmuted)');
                
                // Try to enter fullscreen after user interaction
                setTimeout(() => {
                    enterFullscreen();
                }, 100);
            } catch (error) {
                console.error('Failed to play after click:', error);
                showError('Failed to start playback. Please check your browser settings.');
            }
        }
        
        async function handleFullscreenStart() {
            console.log('🚀 Starting playback in fullscreen mode...');
            
            // Hide the fullscreen start overlay
            document.getElementById('fullscreenStartOverlay').classList.add('hide');
            
            // Mark that user has interacted
            hasUserInteracted = true;
            isInitialPlay = false;
            
            try {
                // Enter fullscreen first
                enterFullscreen();
                
                // Wait a moment for fullscreen to activate
                await new Promise(resolve => setTimeout(resolve, 300));
                
                // Start playback
                const playSuccess = await playCurrentVideo();
                
                if (playSuccess) {
                    console.log('✅ Playback started successfully in fullscreen');
                    
                    // Start update intervals
                    updateIntervalId = setInterval(updateInfo, 100);
                    
                    // Start timeline update checker (every 30 seconds)
                    timelineCheckIntervalId = setInterval(checkForTimelineUpdates, 30000);
                } else {
                    console.log('⚠️ Playback did not start immediately, may be buffering');
                }
            } catch (error) {
                console.error('❌ Failed to start in fullscreen:', error);
                showError(`Failed to start: ${error.message}`);
            }
        }

        function startItemDurationCheck() {
            // Clear existing interval
            if (checkIntervalId) {
                clearInterval(checkIntervalId);
            }
            
            // Check every 100ms if item duration has elapsed
            checkIntervalId = setInterval(() => {
                const elapsed = (Date.now() - itemStartTime) / 1000;
                
                if (elapsed >= itemDuration) {
                    console.log(`⏱️  Item duration (${itemDuration}s) reached, advancing to next video`);
                    clearInterval(checkIntervalId);
                    advanceToNextVideo();
                }
            }, 100);
        }

        function advanceToNextVideo() {
            // Clean up
            if (checkIntervalId) {
                clearInterval(checkIntervalId);
            }
            
            if (imageDisplayTimeout) {
                clearTimeout(imageDisplayTimeout);
                imageDisplayTimeout = null;
            }
            
            // Revoke old object URLs to free memory
            if (videoPlayer.src && videoPlayer.src.startsWith('blob:')) {
                URL.revokeObjectURL(videoPlayer.src);
            }
            if (imagePlayer.src && imagePlayer.src.startsWith('blob:')) {
                URL.revokeObjectURL(imagePlayer.src);
            }
            
            // Move to next video
            currentVideoIndex++;
            
            // Check if we've reached the end of the timeline
            if (currentVideoIndex >= timelineItems.length) {
                console.log('🔄 Timeline complete, looping...');
                currentVideoIndex = 0;
                loopCount++;
            }
            
            // Play next video
            playCurrentVideo();
        }

        function updateVideoInfo() {
            if (!videoPlayer) return;
            
            const current = formatTime(videoPlayer.currentTime);
            const duration = formatTime(videoPlayer.duration);
            const elapsed = Math.floor((Date.now() - itemStartTime) / 1000);
            
            document.getElementById('infoVideoTime').textContent = current;
            document.getElementById('infoVideoDuration').textContent = duration;
            document.getElementById('infoItemElapsed').textContent = elapsed;
        }

        function updateInfo() {
            updateVideoInfo();
            
            // Update countdown to next timeline check
            const timeSinceLastCheck = Math.floor((Date.now() - lastTimelineCheck) / 1000);
            const timeUntilNextCheck = Math.max(0, 30 - timeSinceLastCheck);
            document.getElementById('infoNextUpdate').textContent = timeUntilNextCheck;
        }

        // ==================== BACKGROUND CACHING ====================
        async function startBackgroundCaching() {
            console.log('📦 Starting background caching...');
            
            let totalVideos = timelineItems.length;
            let cachedCount = 0;
            
            // Check what's already cached
            for (const item of timelineItems) {
                const cached = await getVideoFromCache(item.video.id);
                if (cached) {
                    cacheStatus[item.video.id].cached = true;
                    cachedCount++;
                }
            }
            
            updateCacheIndicator(cachedCount, totalVideos);
            
            if (cachedCount === totalVideos) {
                console.log('✅ All videos already cached');
                hideCacheIndicator();
                return;
            }
            
            // Cache videos in background
            for (const item of timelineItems) {
                if (cacheStatus[item.video.id].cached) {
                    continue;
                }
                
                try {
                    cacheStatus[item.video.id].caching = true;
                    await cacheVideo(item);
                    cacheStatus[item.video.id].cached = true;
                    cachedCount++;
                    updateCacheIndicator(cachedCount, totalVideos);
                } catch (error) {
                    console.error(`❌ Failed to cache ${item.video.fileName}:`, error);
                    cacheStatus[item.video.id].caching = false;
                }
            }
            
            console.log('✅ Background caching complete');
            setTimeout(() => hideCacheIndicator(), 3000);
        }

        async function cacheVideo(item) {
            const videoId = item.video.id;
            const videoName = item.video.fileName;
            
            console.log(`📥 Caching directly from S3: ${videoName}`);
            
            // Get direct S3 streaming URL
            const streamData = await getVideoStreamURL(videoId);
            const response = await fetch(streamData.streamUrl);
            
            if (!response.ok) {
                throw new Error(`HTTP ${response.status}`);
            }
            
            const blob = await response.blob();
            await saveVideoToCache(videoId, blob);
            
            console.log(`✅ Cached: ${videoName} (${(blob.size / 1024 / 1024).toFixed(2)} MB)`);
        }

        async function getVideoStreamURL(videoId) {
            if (!videoId) {
                throw new Error('Video ID is missing');
            }
            
            // Request pre-signed URL from server
            const response = await fetch(`/api/media/${videoId}/stream-url`);
            
            if (!response.ok) {
                throw new Error(`Failed to get stream URL: ${response.status}`);
            }
            
            const result = await response.json();
            
            if (!result.success || !result.data || !result.data.streamUrl) {
                throw new Error('Invalid stream URL response');
            }
            
            console.log(`🔑 Got direct S3 stream URL (valid for ${result.data.expiresIn / 60} minutes)`);
            
            return result.data;
        }

        function updateCacheIndicator(cached, total) {
            const percent = total > 0 ? Math.round((cached / total) * 100) : 0;
            document.getElementById('cacheText').textContent = `Caching videos... ${cached}/${total} (${percent}%)`;
            document.getElementById('cacheProgressBar').style.width = `${percent}%`;
            document.getElementById('infoCacheStatus').textContent = `${cached}/${total} cached`;
            
            if (cached < total) {
                document.getElementById('cacheIndicator').classList.add('show');
            }
        }

        function hideCacheIndicator() {
            document.getElementById('cacheIndicator').classList.remove('show');
        }

        // ==================== KEYBOARD CONTROLS ====================
        document.addEventListener('keydown', (e) => {
            switch (e.key.toLowerCase()) {
                case 'h':
                    goHome();
                    break;
                case 'f':
                    // Allow user to toggle fullscreen manually with 'f' key
                    const isFullscreen = !!(document.fullscreenElement || 
                                           document.webkitFullscreenElement || 
                                           document.mozFullScreenElement || 
                                           document.msFullscreenElement);
                    if (isFullscreen) {
                        exitFullscreen();
                    } else {
                        enterFullscreen();
                    }
                    break;
            }
        });

        // ==================== FULLSCREEN HANDLING ====================
        function enterFullscreen() {
            if (document.fullscreenElement || document.webkitFullscreenElement || document.mozFullScreenElement) {
                console.log('Already in fullscreen mode');
                return;
            }
            
            hasEnteredFullscreenOnce = true;
            
            // Request fullscreen on document.documentElement (most reliable)
            const element = document.documentElement;
            
            try {
                if (element.requestFullscreen) {
                    element.requestFullscreen().then(() => {
                        console.log('✅ Fullscreen activated');
                    }).catch(err => {
                        console.log('⚠️ Fullscreen request denied:', err.message);
                        console.log('You may need to interact with the page first or enable fullscreen in browser settings');
                    });
                } else if (element.webkitRequestFullscreen) {
                    // Safari
                    element.webkitRequestFullscreen();
                    console.log('✅ Fullscreen activated (webkit)');
                } else if (element.mozRequestFullScreen) {
                    // Firefox
                    element.mozRequestFullScreen();
                    console.log('✅ Fullscreen activated (moz)');
                } else if (element.msRequestFullscreen) {
                    // IE/Edge
                    element.msRequestFullscreen();
                    console.log('✅ Fullscreen activated (ms)');
                } else {
                    console.log('⚠️ Fullscreen API not supported in this browser');
                }
            } catch (err) {
                console.error('❌ Fullscreen error:', err);
            }
        }

        // Exit fullscreen function
        function exitFullscreen() {
            try {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                } else if (document.webkitExitFullscreen) {
                    document.webkitExitFullscreen();
                } else if (document.mozCancelFullScreen) {
                    document.mozCancelFullScreen();
                } else if (document.msExitFullscreen) {
                    document.msExitFullscreen();
                }
            } catch (err) {
                console.error('❌ Exit fullscreen error:', err);
            }
        }
        
        // Listen for fullscreen changes (all browser prefixes)
        document.addEventListener('fullscreenchange', handleFullscreenChange);
        document.addEventListener('webkitfullscreenchange', handleFullscreenChange);
        document.addEventListener('mozfullscreenchange', handleFullscreenChange);
        document.addEventListener('MSFullscreenChange', handleFullscreenChange);
        
        function handleFullscreenChange() {
            const isFullscreen = !!(document.fullscreenElement || 
                                   document.webkitFullscreenElement || 
                                   document.mozFullScreenElement || 
                                   document.msFullscreenElement);
            
            // Update fullscreen button text and icon
            const fullscreenBtn = document.getElementById('fullscreenToggleBtn');
            const fullscreenIcon = document.getElementById('fullscreenIcon');
            const fullscreenText = document.getElementById('fullscreenText');
            
            if (isFullscreen) {
                console.log('📺 Entered fullscreen mode');
                document.body.classList.add('is-fullscreen');
                
                if (fullscreenIcon) fullscreenIcon.className = 'bi bi-fullscreen-exit';
                if (fullscreenText) fullscreenText.textContent = 'Exit Fullscreen';
            } else {
                console.log('🖥️  Exited fullscreen mode');
                document.body.classList.remove('is-fullscreen');
                
                if (fullscreenIcon) fullscreenIcon.className = 'bi bi-arrows-fullscreen';
                if (fullscreenText) fullscreenText.textContent = 'Enter Fullscreen';
            }
        }
        
        function toggleFullscreen() {
            const isFullscreen = !!(document.fullscreenElement || 
                                   document.webkitFullscreenElement || 
                                   document.mozFullScreenElement || 
                                   document.msFullscreenElement);
            
            if (isFullscreen) {
                exitFullscreen();
            } else {
                enterFullscreen();
            }
        }

        // ==================== UTILITY FUNCTIONS ====================
        function formatTime(seconds) {
            if (isNaN(seconds) || seconds < 0) return '00:00';
            const s = Math.floor(seconds % 60);
            const m = Math.floor((seconds / 60) % 60);
            const h = Math.floor(seconds / 3600);
            if (h > 0) return `${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
            return `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
        }

        function updateLicenseDisplay(license) {
            if (!license || !license.expiresAt) {
                document.getElementById('infoLicenseExpiry').textContent = 'No license info';
                return;
            }

            const now = new Date();
            const expiryDate = new Date(license.expiresAt);
            const daysRemaining = Math.ceil((expiryDate - now) / (1000 * 60 * 60 * 24));
            
            let displayText;
            let textColor = '';
            
            if (license.isExpired || daysRemaining < 0) {
                displayText = '❌ EXPIRED';
                textColor = '#dc3545'; // Red
            } else if (daysRemaining === 0) {
                displayText = '⚠️ Expires today';
                textColor = '#fd7e14'; // Orange
            } else if (daysRemaining === 1) {
                displayText = `⚠️ ${daysRemaining} day remaining`;
                textColor = '#fd7e14'; // Orange
            } else if (daysRemaining <= 7) {
                displayText = `⚠️ ${daysRemaining} days remaining`;
                textColor = '#ffc107'; // Yellow/Warning
            } else if (daysRemaining <= 30) {
                displayText = `${daysRemaining} days remaining`;
                textColor = '#0dcaf0'; // Info blue
            } else {
                displayText = `${daysRemaining} days remaining`;
                textColor = '#20c997'; // Green/Success
            }
            
            const licenseElement = document.getElementById('infoLicenseExpiry');
            licenseElement.textContent = displayText;
            licenseElement.style.color = textColor;
            licenseElement.style.fontWeight = daysRemaining <= 7 ? 'bold' : 'normal';
            
            console.log(`📅 License: ${displayText} (Expires: ${expiryDate.toLocaleDateString()})`);
        }

        async function goHome() {
            if (confirm('Clear registration and go back to home?')) {
                if (checkIntervalId) clearInterval(checkIntervalId);
                if (updateIntervalId) clearInterval(updateIntervalId);
                if (timelineCheckIntervalId) clearInterval(timelineCheckIntervalId);
                
                try {
                    // Get device UID from registration data
                    const storedData = localStorage.getItem('devicePlaylistRegistration');
                    if (storedData) {
                        const regData = JSON.parse(storedData);
                        const deviceUID = regData.uid || regData.device?.uid;
                        
                        if (deviceUID) {
                            console.log('🗑️  Deregistering device from database:', deviceUID);
                            
                            // Call API to deregister device
                            try {
                                const response = await fetch(`/api/device/deregister/${encodeURIComponent(deviceUID)}`, {
                                    method: 'DELETE',
                                });
                                
                                const result = await response.json();
                                
                                if (result.success) {
                                    console.log('✅ Device deregistered from database');
                                } else {
                                    console.warn('⚠️  Failed to deregister device:', result.message);
                                }
                            } catch (apiError) {
                                console.error('❌ Error calling deregister API:', apiError);
                                // Continue with cleanup even if API call fails
                            }
                        }
                    }
                    
                    // Clear video cache
                    await clearVideoCache();
                    
                    // Clear local storage
                    localStorage.removeItem('devicePlaylistRegistration');
                    localStorage.removeItem('deviceUID');
                    
                    // Redirect to home
                    window.location.href = '/';
                } catch (err) {
                    console.error('Error during deregistration:', err);
                    
                    // Clean up local data even if there's an error
                    localStorage.removeItem('devicePlaylistRegistration');
                    localStorage.removeItem('deviceUID');
                    window.location.href = '/';
                }
            }
        }

        function showError(message) {
            document.getElementById('errorMessage').textContent = message;
            document.getElementById('errorOverlay').classList.add('show');
        }

        // Cleanup on page unload
        window.addEventListener('beforeunload', () => {
            if (checkIntervalId) clearInterval(checkIntervalId);
            if (updateIntervalId) clearInterval(updateIntervalId);
            if (timelineCheckIntervalId) clearInterval(timelineCheckIntervalId);
            if (imageDisplayTimeout) clearTimeout(imageDisplayTimeout);
            if (videoPlayer && videoPlayer.src && videoPlayer.src.startsWith('blob:')) {
                URL.revokeObjectURL(videoPlayer.src);
            }
            if (imagePlayer && imagePlayer.src && imagePlayer.src.startsWith('blob:')) {
                URL.revokeObjectURL(imagePlayer.src);
            }
        });
    </script>
</body>
</html>
