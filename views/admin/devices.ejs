<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
    <title>Device Management - Digital Signage</title>
    <style>
        body {
            background: #f8f9fa;
            min-height: 100vh;
            padding-bottom: 50px;
        }
        .page-title { color: #2d3748; }
        .breadcrumb-custom { background: rgba(102, 126, 234, 0.1); padding: 10px 15px; border-radius: 8px; }
        .breadcrumb-custom .breadcrumb-item a { color: #667eea; text-decoration: none; }
        .breadcrumb-custom .breadcrumb-item.active { color: #2d3748; }
        .content-card {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }
        .status-dot {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            margin-right: 5px;
        }
        .status-dot.online {
            background-color: #10b981;
            animation: pulse 2s infinite;
            box-shadow: 0 0 8px rgba(16, 185, 129, 0.6);
        }
        .status-dot.offline {
            background-color: #ef4444;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.6; }
        }
        .filter-section {
            background: rgba(102, 126, 234, 0.05);
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
        }
        .stats-badge {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 12px;
            font-size: 12px;
            margin-right: 8px;
            margin-bottom: 8px;
        }
    </style>
</head>
<body>
    <%- include('../partials/navbar', { user, session }) %>

    <div class="content-wrapper">
        <div class="container">
            <div class="mb-4">
                <h1 class="page-title"><i class="bi bi-display"></i> Device Management</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb breadcrumb-custom">
                        <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
                        <li class="breadcrumb-item active">Devices</li>
                    </ol>
                </nav>
            </div>

            <div class="content-card">
                <!-- Filter Section -->
                <div class="filter-section mb-4">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Status</label>
                            <select class="form-select form-select-sm" id="filterStatus">
                                <option value="">All Status</option>
                                <option value="online">Online</option>
                                <option value="offline">Offline</option>
                            </select>
                        </div>
                        <% if (isSuperAdmin && companies.length > 0) { %>
                        <div class="col-md-3">
                            <label class="form-label">Company</label>
                            <select class="form-select form-select-sm" id="filterCompany">
                                <option value="">All Companies</option>
                                <% companies.forEach(company => { %>
                                    <option value="<%= company.id %>"><%= company.name %></option>
                                <% }); %>
                            </select>
                        </div>
                        <% } %>
                        <div class="col-md-<%= isSuperAdmin && companies.length > 0 ? '6' : '9' %>">
                            <label class="form-label">Search</label>
                            <input type="text" class="form-control form-control-sm" id="searchInput" placeholder="Search by UID, Playlist, Company...">
                        </div>
                    </div>
                </div>

                <!-- Stats -->
                <div class="mb-3">
                    <span class="stats-badge bg-primary text-white" id="deviceCount">
                        <i class="bi bi-display"></i> <%= devices.length %> Device(s)
                    </span>
                    <span class="stats-badge bg-success text-white" id="onlineCount">
                        <i class="bi bi-circle-fill"></i> 0 Online
                    </span>
                    <span class="stats-badge bg-danger text-white" id="offlineCount">
                        <i class="bi bi-circle-fill"></i> 0 Offline
                    </span>
                </div>

                <!-- Devices Table -->
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Device UID</th>
                                <th>Playlist</th>
                                <th>Company</th>
                                <th>Status</th>
                                <th>Last Seen</th>
                                <th>Registered</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="devicesTable">
                            <% if (devices.length === 0) { %>
                                <tr>
                                    <td colspan="7" class="text-center py-5">
                                        <i class="bi bi-display" style="font-size: 64px; color: #e2e8f0;"></i>
                                        <h5 class="mt-3 text-muted">No devices registered yet</h5>
                                        <p class="text-muted mb-0">Devices will appear here once they register with a playlist code.</p>
                                    </td>
                                </tr>
                            <% } else { %>
                                <% devices.forEach(device => { %>
                                    <tr data-device-uid="<%= device.uid %>"
                                        data-status="<%= device.isOnline ? 'online' : 'offline' %>"
                                        data-company-id="<%= device.devicePlaylists[0]?.playlist?.companyId || '' %>"
                                        data-search-text="<%= device.uid %> <%= device.devicePlaylists[0]?.playlist?.name || '' %> <%= device.devicePlaylists[0]?.playlist?.company?.name || '' %>">
                                        <td>
                                            <code><%= device.uid %></code>
                                            <% if (device.deviceInfo && Object.keys(device.deviceInfo).length > 0) { %>
                                                <br><small class="text-muted">
                                                    <%= device.deviceInfo.resolution || 'N/A' %> • <%= device.deviceInfo.platform || 'N/A' %>
                                                </small>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (device.devicePlaylists && device.devicePlaylists.length > 0) { %>
                                                <% const playlist = device.devicePlaylists[0].playlist; %>
                                                <strong><%= playlist.name %></strong>
                                                <br><span class="badge bg-info"><%= playlist.code %></span>
                                            <% } else { %>
                                                <span class="text-muted">No playlist</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (device.devicePlaylists && device.devicePlaylists.length > 0) { %>
                                                <%= device.devicePlaylists[0].playlist.company.name %>
                                            <% } else { %>
                                                <span class="text-muted">-</span>
                                            <% } %>
                                        </td>
                                        <td class="status-cell">
                                            <% if (device.isOnline) { %>
                                                <span class="badge bg-success">
                                                    <span class="status-dot online"></span> Online
                                                </span>
                                            <% } else { %>
                                                <span class="badge bg-danger">
                                                    <span class="status-dot offline"></span> Offline
                                                </span>
                                            <% } %>
                                        </td>
                                        <td class="last-seen-cell">
                                            <% if (device.isOnline) { %>
                                                <span class="text-success">Just now</span>
                                            <% } else if (device.minutesSinceLastSeen < 60) { %>
                                                <%= device.minutesSinceLastSeen %> min ago
                                            <% } else if (device.minutesSinceLastSeen < 1440) { %>
                                                <%= Math.floor(device.minutesSinceLastSeen / 60) %> hr ago
                                            <% } else { %>
                                                <%= Math.floor(device.minutesSinceLastSeen / 1440) %> day(s) ago
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (device.devicePlaylists && device.devicePlaylists.length > 0) { %>
                                                <%= new Date(device.devicePlaylists[0].registeredAt).toLocaleDateString() %>
                                            <% } else { %>
                                                <span class="text-muted">-</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-danger delete-device-btn"
                                                    data-device-uid="<%= device.uid %>"
                                                    data-playlist-name="<%= device.devicePlaylists[0]?.playlist?.name || 'Unknown' %>"
                                                    title="Delete Device">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true" style="display: none;">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle"></i> Confirm Delete</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this device?</p>
                    <div class="alert alert-warning">
                        <strong>UID:</strong> <code id="deleteDeviceUID"></code><br>
                        <strong>Playlist:</strong> <span id="deletePlaylistName"></span>
                    </div>
                    <p class="mb-0 text-danger"><strong>Warning:</strong> This action cannot be undone. If the device is online, it will be automatically deregistered.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                        <i class="bi bi-trash"></i> Delete Device
                    </button>
                </div>
            </div>
        </div>
    </div>

    <%- include('../partials/scripts') %>
    <script src="https://cdn.socket.io/4.5.4/socket.io.min.js"></script>
    <script>
        let selectedDeviceUID = null;
        let socket = null;

        // Initialize Socket.IO for real-time updates
        function initSocket() {
            socket = io(window.location.origin);

            socket.on('admin:device:online', (data) => {
                console.log('Device online:', data);
                updateDeviceStatus(data.uid, true);
            });

            socket.on('admin:device:offline', (data) => {
                console.log('Device offline:', data);
                updateDeviceStatus(data.uid, false);
            });
        }

        // Update device status in real-time
        function updateDeviceStatus(uid, isOnline) {
            const deviceRow = document.querySelector(`tr[data-device-uid="${uid}"]`);
            if (deviceRow) {
                const statusCell = deviceRow.querySelector('.status-cell');
                const lastSeenCell = deviceRow.querySelector('.last-seen-cell');
                
                if (isOnline) {
                    statusCell.innerHTML = '<span class="badge bg-success"><span class="status-dot online"></span> Online</span>';
                    lastSeenCell.innerHTML = '<span class="text-success">Just now</span>';
                    deviceRow.dataset.status = 'online';
                } else {
                    statusCell.innerHTML = '<span class="badge bg-danger"><span class="status-dot offline"></span> Offline</span>';
                    lastSeenCell.textContent = 'Just now';
                    deviceRow.dataset.status = 'offline';
                }
                
                updateCounts();
            }
        }

        // Update counts
        function updateCounts() {
            const allRows = document.querySelectorAll('#devicesTable tr[data-device-uid]');
            const visibleRows = Array.from(allRows).filter(row => row.style.display !== 'none');
            const onlineRows = visibleRows.filter(row => row.dataset.status === 'online');
            const offlineRows = visibleRows.filter(row => row.dataset.status === 'offline');
            
            document.getElementById('deviceCount').innerHTML = `<i class="bi bi-display"></i> ${visibleRows.length} Device(s)`;
            document.getElementById('onlineCount').innerHTML = `<i class="bi bi-circle-fill"></i> ${onlineRows.length} Online`;
            document.getElementById('offlineCount').innerHTML = `<i class="bi bi-circle-fill"></i> ${offlineRows.length} Offline`;
        }

        // Filter devices
        function filterDevices() {
            const statusFilter = document.getElementById('filterStatus').value;
            const companyFilter = document.getElementById('filterCompany')?.value || '';
            const searchQuery = document.getElementById('searchInput').value.toLowerCase();
            
            const deviceRows = document.querySelectorAll('#devicesTable tr[data-device-uid]');
            
            deviceRows.forEach(row => {
                const status = row.dataset.status;
                const companyId = row.dataset.companyId;
                const searchText = row.dataset.searchText.toLowerCase();
                
                const statusMatch = !statusFilter || status === statusFilter;
                const companyMatch = !companyFilter || companyId === companyFilter;
                const searchMatch = !searchQuery || searchText.includes(searchQuery);
                
                if (statusMatch && companyMatch && searchMatch) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
            
            updateCounts();
        }

        // Delete device
        async function deleteDevice(uid) {
            try {
                const response = await fetch(`/admin/devices/${encodeURIComponent(uid)}`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                });

                const result = await response.json();

                if (result.success) {
                    alert('Device deleted successfully');
                    
                    // Remove device row from UI
                    const deviceRow = document.querySelector(`tr[data-device-uid="${uid}"]`);
                    if (deviceRow) {
                        deviceRow.remove();
                    }
                    
                    updateCounts();
                    
                    // Check if no devices left
                    const remainingRows = document.querySelectorAll('#devicesTable tr[data-device-uid]');
                    if (remainingRows.length === 0) {
                        document.getElementById('devicesTable').innerHTML = `
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <i class="bi bi-display" style="font-size: 64px; color: #e2e8f0;"></i>
                                    <h5 class="mt-3 text-muted">No devices registered yet</h5>
                                    <p class="text-muted mb-0">Devices will appear here once they register with a playlist code.</p>
                                </td>
                            </tr>
                        `;
                    }
                } else {
                    alert(result.message || 'Failed to delete device');
                }
            } catch (error) {
                console.error('Error deleting device:', error);
                alert('An error occurred while deleting the device');
            }
        }

        // Event listeners
        document.addEventListener('DOMContentLoaded', () => {
            // Ensure modal is hidden on page load
            const deleteModalEl = document.getElementById('deleteModal');
            if (deleteModalEl) {
                deleteModalEl.style.display = 'none';
                deleteModalEl.classList.remove('show');
            }
            
            // Initialize Socket.IO
            initSocket();
            
            // Initial count update
            updateCounts();
            
            // Filter listeners
            document.getElementById('filterStatus').addEventListener('change', filterDevices);
            if (document.getElementById('filterCompany')) {
                document.getElementById('filterCompany').addEventListener('change', filterDevices);
            }
            document.getElementById('searchInput').addEventListener('input', filterDevices);
            
            // Delete button listeners
            document.querySelectorAll('.delete-device-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    const uid = e.currentTarget.dataset.deviceUid;
                    const playlistName = e.currentTarget.dataset.playlistName;
                    
                    selectedDeviceUID = uid;
                    document.getElementById('deleteDeviceUID').textContent = uid;
                    document.getElementById('deletePlaylistName').textContent = playlistName;
                    
                    const modal = new bootstrap.Modal(deleteModalEl, {
                        backdrop: 'static',
                        keyboard: false
                    });
                    modal.show();
                });
            });
            
            // Confirm delete
            document.getElementById('confirmDeleteBtn').addEventListener('click', async () => {
                if (selectedDeviceUID) {
                    await deleteDevice(selectedDeviceUID);
                    
                    const modal = bootstrap.Modal.getInstance(deleteModalEl);
                    if (modal) {
                        modal.hide();
                    }
                    
                    selectedDeviceUID = null;
                }
            });
        });
    </script>
</body>
</html>

